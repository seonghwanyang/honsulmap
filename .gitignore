# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env

# sensitive
session_b64.txt

# reference images / debug artifacts
ref/
scripts/*.json
scripts/*_log.txt
scripts/debug_*.py
scripts/test_*.py
scripts/test_*.ts
scripts/naver_tls_probe.py
scripts/naver_playwright_probe.py

# scripts/ output artifacts (always cruft)
scripts/*.log
scripts/*.html
scripts/*.png
scripts/*.txt
scripts/*.js

# Throwaway debug / probe scripts go under scripts/debug/, which is
# never committed. Anything in scripts/ root is treated as a real,
# reusable script.
scripts/debug/

# favicon reference image (kept locally, not in repo)
/honsulmap_favicon_ref.png

# session temp logs at repo root
.tmp-*

# one-off data import sources
*.xlsx

# python
__pycache__/
*.pyc
*.pyo
worker_venv/
.venv/
.omc/
.claude/scheduled_tasks.lock

# Google OAuth client secret JSON — never commit (public repo)
client_secret_*.json
