# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Naver Map
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your-client-id

# Kakao AdFit (optional)
NEXT_PUBLIC_ADFIT_UNIT_ID_BANNER=your-banner-unit-id
NEXT_PUBLIC_ADFIT_UNIT_ID_INLINE=your-inline-unit-id

# Sentry (에러 모니터링) — DSN은 공개값이라 비우면 코드 기본값을 쓴다.
# 아래 셋은 빌드 때 소스맵 업로드용. 로컬엔 없어도 되고 Vercel(Production·Preview)에만 넣는다.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
